<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:endColor="#07271C"
                android:startColor="#0B3D2E" />
            <stroke
                android:width="2dp"
                android:color="#C9A227" />
        </shape>
    </item>
    <item
        android:height="3dp"
        android:gravity="bottom">
        <shape android:shape="rectangle">
            <solid android:color="#E7C873" />
        </shape>
    </item>
</layer-list>
