<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚙️ Settings"
        android:textColor="#C084FC"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Gemini API Key"
        android:textColor="#E2E8F0" />

    <EditText
        android:id="@+id/setKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:hint="Key বসাও"
        android:inputType="textPassword"
        android:padding="12dp"
        android:textColor="#E8F4FF"
        android:textColorHint="#64748B" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="🔑 মালিকের Key-ঘর (একটা নিচে একটা) দেখতে: মূল স্ক্রিনে Settings বাটন চেপে ধরে রাখুন → PIN দিন"
        android:textColor="#A78BFA"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="ভয়েসের গতি"
        android:textColor="#E2E8F0" />

    <SeekBar
        android:id="@+id/setSpeed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="20" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="ভয়েসের উচ্চতা (pitch)"
        android:textColor="#E2E8F0" />

    <SeekBar
        android:id="@+id/setPitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="20" />

    <CheckBox
        android:id="@+id/setEnglish"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="English ভাষা"
        android:textColor="#E2E8F0" />

    <CheckBox
        android:id="@+id/setMainVoice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="মেইন স্ক্রিনে ভয়েস উত্তর"
        android:textColor="#E2E8F0" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="bKash নম্বর (প্রিমিয়াম পেমেন্টের জন্য)"
        android:textColor="#E2E8F0" />

    <EditText
        android:id="@+id/setBkash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:hint="01XXXXXXXXX"
        android:inputType="phone"
        android:padding="12dp"
        android:textColor="#E8F4FF"
        android:textColorHint="#64748B" />

    <TextView
        android:id="@+id/setKeyLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="আরেকটা Gemini Key যোগ করো (শুধু মালিক)"
        android:textColor="#E2E8F0" />

    <LinearLayout
        android:id="@+id/setKeysList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <Button
        android:id="@+id/setAddKeyRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/btn_secondary"
        android:text="＋ আরেকটা ঘর"
        android:textColor="#E9D5FF" />

    <TextView
        android:id="@+id/setKeyCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/setAnnounceTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:hint="ঘোষণার শিরোনাম"
        android:padding="12dp"
        android:textColor="#E8F4FF"
        android:textColorHint="#64748B" />

    <EditText
        android:id="@+id/setAnnounceBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:hint="ঘোষণার লেখা"
        android:padding="12dp"
        android:textColor="#E8F4FF"
        android:textColorHint="#64748B" />

    <EditText
        android:id="@+id/setServerToken"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:hint="সার্ভার টোকেন"
        android:inputType="textPassword"
        android:padding="12dp"
        android:textColor="#E8F4FF"
        android:textColorHint="#64748B" />

    <Button
        android:id="@+id/setSendAnnounce"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/btn_primary"
        android:text="📢 ঘোষণা পাঠাও"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/setClearKeys"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_secondary"
        android:text="সব Key মুছো"
        android:textColor="#E9D5FF" />

    <Button
        android:id="@+id/setSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/btn_primary"
        android:text="সেভ করো"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/setInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="#94A3B8"
        android:textSize="12sp" />
</LinearLayout>
