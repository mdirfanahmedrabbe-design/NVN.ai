<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚙️ Settings"
        android:textColor="#C084FC"
        android:textSize="22sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/setKeysBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/btn_primary"
        android:padding="12dp"
        android:text="🔑 Gemini Key-ঘর (আলাদা পেজ)"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/setConnectBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_primary"
        android:padding="12dp"
        android:text="🔗 কানেক্ট সিস্টেম (আলাদা পেজ)"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="ভয়েসের গতি"
        android:textColor="#E2E8F0" />

    <SeekBar
        android:id="@+id/setSpeed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="20" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="ভয়েসের উচ্চতা (pitch)"
        android:textColor="#E2E8F0" />

    <SeekBar
        android:id="@+id/setPitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="20" />

    <CheckBox
        android:id="@+id/setEnglish"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="English ভাষা"
        android:textColor="#E2E8F0" />

    <CheckBox
        android:id="@+id/setMainVoice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="মেইন স্ক্রিনে ভয়েস উত্তর"
        android:textColor="#E2E8F0" />

    <CheckBox
        android:id="@+id/setFastMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="⚡ দ্রুত মোড (হালকা মডেল — ফাস্ট উত্তর, দিনে বেশি রিকোয়েস্ট)"
        android:textColor="#E2E8F0" />

    <Button
        android:id="@+id/setOrbColorBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_secondary"
        android:padding="12dp"
        android:text="🎨 বলের রং: অটো (রং বদলায়)"
        android:textColor="#E8F4FF"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="bKash নম্বর (প্রিমিয়াম পেমেন্টের জন্য)"
        android:textColor="#E2E8F0" />

    <EditText
        android:id="@+id/setBkash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:hint="01XXXXXXXXX"
        android:inputType="phone"
        android:padding="12dp"
        android:textColor="#E8F4FF"
        android:textColorHint="#64748B" />

    <Button
        android:id="@+id/setAnnounceBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/btn_secondary"
        android:padding="12dp"
        android:text="📢 ঘোষণা পেজ (আলাদা পেজ)"
        android:textColor="#E8F4FF"
        android:textSize="15sp" />

    <Button
        android:id="@+id/setOwnerBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/btn_primary"
        android:padding="12dp"
        android:text="👑 মালিক মোড"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <Button
        android:id="@+id/setStatusBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/btn_secondary"
        android:padding="12dp"
        android:text="🔔 নোটিফিকেশন ও অবস্থা"
        android:textColor="#E8F4FF"
        android:textSize="15sp" />

    <Button
        android:id="@+id/setAboutBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/btn_secondary"
        android:padding="12dp"
        android:text="ℹ️ অ্যাপ সম্পর্কে — কে তৈরি করেছে"
        android:textColor="#E8F4FF"
        android:textSize="15sp" />

    <Button
        android:id="@+id/setSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/btn_primary"
        android:text="সেভ করো"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/setInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="#94A3B8"
        android:textSize="12sp" />
</LinearLayout>
