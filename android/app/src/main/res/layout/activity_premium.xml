<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="👑 প্রিমিয়াম প্যাকেজ"
            android:textColor="#E7C873"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/premStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:textColor="#EDE6D6"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/premList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/premBkash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:textColor="#F3E9C8"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/premTrxid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:hint="bKash TrxID (যেমন: ABC123XYZ9)"
            android:padding="12dp"
            android:textColor="#F3E9C8"
            android:textColorHint="#A8C3B2" />

        <Button
            android:id="@+id/premVerify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_primary"
            android:text="যাচাই করে চালু করো"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="টাকা পাঠানোর পর TrxID দিলেই সাথে সাথে প্রিমিয়াম চালু হবে। লিমিট প্রতিদিন নতুন করে শুরু হয়।"
            android:textColor="#A8C3B2"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
