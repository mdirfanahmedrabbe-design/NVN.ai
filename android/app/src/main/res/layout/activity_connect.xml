<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔗 কানেক্ট সিস্টেম"
        android:textColor="#E7C873"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="যে সাইট কানেক্ট করবে, তার আলাদা পেজে কাজের নিয়ম লিখে দাও। সে প্রতিদিন শিডিউল অনুযায়ী কমেন্টের উত্তর আর পোস্ট করবে — স্ক্রিন অফ থাকলেও চলবে।"
        android:textColor="#C9A227"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/connSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input"
        android:hint="🔍 সাইট/অ্যাপ খুঁজো (যেমন: facebook, blogger, tiktok)"
        android:padding="12dp"
        android:textColor="#F3E9C8"
        android:textColorHint="#A8C3B2" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/connList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/connRunNow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/btn_primary"
        android:padding="12dp"
        android:text="▶️ এখনই কাজ করো"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <Button
        android:id="@+id/connApprovals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_secondary"
        android:padding="12dp"
        android:text="📋 অনুমোদনের অপেক্ষায়"
        android:textColor="#F3E9C8" />

    <Button
        android:id="@+id/connHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_secondary"
        android:padding="12dp"
        android:text="📜 কাজের ইতিহাস"
        android:textColor="#F3E9C8" />
</LinearLayout>
