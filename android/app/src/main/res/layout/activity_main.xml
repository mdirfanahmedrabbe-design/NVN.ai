<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/menuBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_secondary"
            android:text="☰"
            android:textColor="#E8F4FF"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚛ NVN AI"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Personal Assistant"
                android:textColor="#A78BFA"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/bellBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_secondary"
            android:text="🔔"
            android:textColor="#E8F4FF"
            android:textSize="15sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.archer.ai.GirlView
            android:id="@+id/mainGirl"
            android:layout_width="260dp"
            android:layout_height="320dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <Button
        android:id="@+id/liveBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/btn_primary"
        android:text="((•)) On Live ›"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/onlinePill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:text="● Online for 0 min"
        android:textColor="#4ADE80"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:orientation="horizontal"
        android:padding="6dp">

        <Button
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="🏠\nHome"
            android:textColor="#C084FC"
            android:textSize="11sp" />

        <Button
            android:id="@+id/navHistory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="🕐\nHistory"
            android:textColor="#E8F4FF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/navShare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="🔗\nShare"
            android:textColor="#E8F4FF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="⚙\nSettings"
            android:textColor="#E8F4FF"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
