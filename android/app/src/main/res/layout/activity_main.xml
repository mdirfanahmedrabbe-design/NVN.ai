<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_emerald"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/panel_emerald"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚛"
            android:textColor="#E7C873"
            android:textSize="30sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="NVN AI"
                android:textColor="#D9F2E4"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Personal Assistant"
                android:textColor="#E7C873"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="EMERALD PALACE&#10;SECURE ASSISTANT • v2.1"
            android:textColor="#A7E8C8"
            android:textSize="8sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.archer.ai.OrbView
            android:id="@+id/mainOrb"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginTop="14dp"
            android:fontFamily="monospace"
            android:text="ORBIT RADIUS:&#10;45mm"
            android:textColor="#A7E8C8"
            android:textSize="9sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:fontFamily="monospace"
            android:text="PARTICLE COUNT:&#10;1200"
            android:textColor="#A7E8C8"
            android:textSize="9sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="10dp"
            android:fontFamily="monospace"
            android:text="FIELD: ACTIVE&#10;2.4GHz"
            android:textColor="#A7E8C8"
            android:textSize="9sp" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="monospace"
        android:text="VOICE ASSISTANT • STANDBY &gt; READY"
        android:textColor="#A7E8C8"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/liveBtn"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/btn_emerald"
            android:fontFamily="monospace"
            android:text="((•)) ON LIVE"
            android:textColor="#D9F2E4"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/chatBtn"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/btn_emerald2"
            android:fontFamily="monospace"
            android:text="💬 CHAT"
            android:textColor="#A7E8C8"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/panel_emerald"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="PALACE DASHBOARD // CONNECTED APPS &amp; TODAY'S USAGE"
            android:textColor="#E7C873"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dashText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:text="CONNECTED APPS: 0"
            android:textColor="#D9F2E4"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/dashApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/dashUsage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="TODAY'S USAGE"
            android:textColor="#E7C873"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/barQuestions"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#C9A227" />

        <ProgressBar
            android:id="@+id/barLive"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#C9A227" />

        <TextView
            android:id="@+id/onlinePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:text="● Online for 0 min"
            android:textColor="#4ADE80"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/quickTorch"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/btn_emerald2"
                android:text="🔦 টর্চ"
                android:textColor="#A7E8C8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/quickPrayer"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/btn_emerald2"
                android:text="🕌 নামাজ"
                android:textColor="#A7E8C8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/quickAlarm"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/btn_emerald2"
                android:text="⏰ অ্যালার্ম"
                android:textColor="#A7E8C8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/quickCamera"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/btn_emerald2"
                android:text="📸 ক্যামেরা"
                android:textColor="#A7E8C8"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/panel_emerald"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="🏠&#10;Home"
            android:textColor="#E7C873"
            android:textSize="11sp" />

        <Button
            android:id="@+id/navHistory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="🕐&#10;History"
            android:textColor="#A7E8C8"
            android:textSize="11sp" />

        <Button
            android:id="@+id/navShare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="🔗&#10;Share"
            android:textColor="#A7E8C8"
            android:textSize="11sp" />

        <Button
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="⚙&#10;Settings"
            android:textColor="#A7E8C8"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
