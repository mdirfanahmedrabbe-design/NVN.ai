<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/svcTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C084FC"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/svcCustomNameWrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="সাইটের নাম"
                android:textColor="#E2E8F0" />

            <EditText
                android:id="@+id/svcCustomName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="যেমন: আমার ব্লগ"
                android:padding="12dp"
                android:textColor="#E8F4FF"
                android:textColorHint="#64748B" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Token / Key (শুধু তোমার ফোনেই থাকবে)"
            android:textColor="#E2E8F0" />

        <EditText
            android:id="@+id/svcToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="Token বসাও"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="#E8F4FF"
            android:textColorHint="#64748B" />

        <Button
            android:id="@+id/svcTokenBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_secondary"
            android:padding="12dp"
            android:text="🔐 লগইন করে Token নাও (অফিসিয়াল পেজ খুলবে)"
            android:textColor="#E8F4FF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Username (যদি লাগে)"
            android:textColor="#E2E8F0" />

        <EditText
            android:id="@+id/svcUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="Username"
            android:padding="12dp"
            android:textColor="#E8F4FF"
            android:textColorHint="#64748B" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Password / App Password (যদি লাগে — শুধু তোমার ফোনেই থাকবে)"
            android:textColor="#E2E8F0" />

        <EditText
            android:id="@+id/svcPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="Password"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="#E8F4FF"
            android:textColorHint="#64748B" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="ID / URL"
            android:textColor="#E2E8F0" />

        <EditText
            android:id="@+id/svcId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="Page ID / Chat ID / URL"
            android:padding="12dp"
            android:textColor="#E8F4FF"
            android:textColorHint="#64748B" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="✍️ কাজের নিয়ম (এই সাইটে সে কীভাবে কাজ করবে, নিজের ভাষায় লিখে দাও)"
            android:textColor="#E2E8F0" />

        <EditText
            android:id="@+id/svcRules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:gravity="top"
            android:hint="যেমন: প্রতিদিন সকালে একটা করে উপকারি পোস্ট করবে। কমেন্টে কেউ দাম জিজ্ঞেস করলে বলবে ইনবক্সে আসতে। রাগী কমেন্টে ঝগড়া করবে না।"
            android:minLines="5"
            android:padding="12dp"
            android:textColor="#E8F4FF"
            android:textColorHint="#64748B" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="প্রতিদিনের পোস্টের সময় (ঘণ্টা : মিনিট, ২৪ ঘণ্টার হিসাব)"
            android:textColor="#E2E8F0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/svcHour"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="9"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="#E8F4FF"
                android:textColorHint="#64748B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:padding="8dp"
                android:text=":"
                android:textColor="#E2E8F0" />

            <EditText
                android:id="@+id/svcMinute"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="0"
                android:inputType="number"
                android:padding="12dp"
                android:textColor="#E8F4FF"
                android:textColorHint="#64748B" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/svcEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="এই সাইটে কাজ চালু"
            android:textColor="#E2E8F0" />

        <CheckBox
            android:id="@+id/svcComments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="কমেন্ট দেখে উত্তর দেবে"
            android:textColor="#E2E8F0" />

        <CheckBox
            android:id="@+id/svcPost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="প্রতিদিন পোস্ট করবে"
            android:textColor="#E2E8F0" />

        <CheckBox
            android:id="@+id/svcApprove"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="পাঠানোর আগে দেখিয়ে হ্যাঁ নাও (বন্ধ করলে অটো পাঠাবে)"
            android:textColor="#E2E8F0" />

        <CheckBox
            android:id="@+id/svcBrowser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🌐 ব্রাউজার মোড (Token লাগবে না — Chrome-এ লগইন থাকলেই সে নিজে গিয়ে কাজ করবে)"
            android:textColor="#E2E8F0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="ব্রাউজার মোডের সাইটের ঠিকানা"
            android:textColor="#E2E8F0" />

        <EditText
            android:id="@+id/svcSite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="https://…"
            android:inputType="textUri"
            android:padding="12dp"
            android:textColor="#E8F4FF"
            android:textColorHint="#64748B" />

        <Button
            android:id="@+id/svcSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/btn_primary"
            android:padding="12dp"
            android:text="সেভ করো"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/svcInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#94A3B8"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
